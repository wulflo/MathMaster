(
    title: "Learning to multiply",
    intro: "The method used by 珠心算 mental calculators: empty abacus, digits from left to right, and every partial product recorded with two digits. First you learn the procedure; speed comes with practice.",
    lessons: [
        (
            id: "M0",
            title: "The 大九九 table and two-digit recording",
            goal: "Know all 81 single-digit products and always write them with two digits.",
            paragraphs: [
                "Everything starts with the table: every pair of digits from 1 to 9 has a product you should know without counting.",
                "In empty-abacus multiplication every product is recorded with two digits, even when it starts with zero: 2×4 = 08, 3×3 = 09, 7×8 = 56.",
                "That zero is not decoration: it holds the tens rod and keeps the remaining digits from shifting.",
            ],
            example: (
                multiplicand: 2,
                multiplier: 4,
                expected: 8,
                caption: "2 × 4 = 08",
                conclusion: "The product is 8, but it is recorded as 08: the 0 holds the tens rod and the 8 the units rod.",
            ),
        ),
        (
            id: "M1",
            title: "One digit by one digit",
            goal: "Solve one digit by one digit by recording the product on two rods.",
            paragraphs: [
                "The abacus starts empty. The rightmost rod is the units rod; the next one to the left is the tens rod.",
                "Multiply the two digits and record the product with two digits: tens on the left, units on the right.",
                "With 7×8 the product 56 is recorded as it is. If the product had a single digit, it would be padded with a leading 0.",
            ],
            example: (
                multiplicand: 7,
                multiplier: 8,
                expected: 56,
                caption: "7 × 8 = 56",
                conclusion: "56 takes two rods: 5 on the tens rod and 6 on the units rod. There is nothing else to add.",
            ),
        ),
        (
            id: "M2",
            title: "Two digits by one digit",
            goal: "Multiply a two-digit number by one digit, from left to right.",
            paragraphs: [
                "Keep the single-digit multiplier in your head; sweep the multiplicand from left to right.",
                "Each product is recorded with two digits and added to what is already on the abacus. Nothing is erased.",
                "In 28×3 you first compute 3×2 = 06 and then 3×8 = 24. The 24 starts on the units rod of the 06 and moves one rod to the right.",
            ],
            example: (
                multiplicand: 28,
                multiplier: 3,
                expected: 84,
                caption: "28 × 3 = 84",
                conclusion: "06 and 24 overlap on one rod: the result is 84.",
            ),
        ),
        (
            id: "M3",
            title: "One digit by two digits",
            goal: "Multiply one digit by a two-digit number by sweeping the multiplier.",
            paragraphs: [
                "Now the multiplier has two digits and sets the order of the steps: first its tens digit, then its units digit.",
                "For each multiplier digit you sweep the whole multiplicand. Here the multiplicand is a single digit, so there is one product per multiplier digit.",
                "It is the same mechanism as M2 with the roles swapped. The final product does not change, but the order of the steps does.",
            ],
            example: (
                multiplicand: 7,
                multiplier: 34,
                expected: 238,
                caption: "7 × 34 = 238",
                conclusion: "3×7 = 21 and 4×7 = 28; the second product starts on the units rod of the first.",
            ),
        ),
        (
            id: "M4",
            title: "Two digits by two digits",
            goal: "Solve 23×45 with four partial products and place-value addition.",
            paragraphs: [
                "The multiplier 45 has two digits: first the 4 is used against the whole 23; then the 5 is used against the whole 23.",
                "4×2 = 08 takes the hundreds and thousands rods; 4×3 = 12 starts one rod to the right. Then come 5×2 = 10 and 5×3 = 15.",
                "Each product is added without erasing the previous one. The result is read when the last pass ends.",
            ],
            example: (
                multiplicand: 23,
                multiplier: 45,
                expected: 1035,
                caption: "23 × 45 = 1035",
                conclusion: "08, 12, 10 and 15 placed by place value give 1035.",
            ),
        ),
        (
            id: "M5",
            title: "Three digits by two digits",
            goal: "Multiply 213×32 while controlling carries and positions.",
            paragraphs: [
                "Now the multiplicand has three digits. For each multiplier digit the whole 213 is swept from left to right.",
                "Within a pass, each product is placed one rod to the right of the previous one.",
                "When the multiplier digit changes, the next pass starts one rod to the right of where the previous pass started.",
            ],
            example: (
                multiplicand: 213,
                multiplier: 32,
                expected: 6816,
                caption: "213 × 32 = 6816",
                conclusion: "The six partial sums accumulate without erasing anything: 6816.",
            ),
        ),
        (
            id: "M6",
            title: "Three digits by three digits",
            goal: "Complete the method with 213×324: nine products and six rods.",
            paragraphs: [
                "This is the full case: three digits by three digits, nine partial products and up to six rods.",
                "Zero control is the delicate part: a 0 digit produces 00 and does not shift the other positions.",
                "If the result starts on an empty rod it has one digit fewer: 位数相加，前空减一, \"add the digits and subtract one if the front stays empty\".",
            ],
            example: (
                multiplicand: 213,
                multiplier: 324,
                expected: 69012,
                caption: "213 × 324 = 69012",
                conclusion: "Nine products, six rods and an inner zero: the result is 69012.",
            ),
        ),
        (
            id: "M7",
            title: "Mental: the same sequence without an abacus",
            goal: "Replay the sequence of products with a mental image of the abacus.",
            paragraphs: [
                "Once the procedure comes without hesitation, cover the abacus and repeat the same sequence of products from left to right.",
                "You do not need to \"see\" anything: just hold the running total and add each product in its position.",
                "Precision comes first; speed drops on its own with practice. The app measures correct answers, not prodigy speed.",
            ],
            example: (
                multiplicand: 23,
                multiplier: 45,
                expected: 1035,
                caption: "23 × 45 = 1035, without an abacus",
                conclusion: "Without an abacus: 08, 12, 10 and 15 placed by position; the final running total is 1035.",
            ),
            show_steps: false,
        ),
        (
            id: "S1",
            title: "Shortcut: teens times teens",
            goal: "Multiply two numbers between 11 and 19 without every partial product.",
            paragraphs: [
                "Condition: both factors are between 11 and 19. Formula: (10+a)(10+b) = 100 + 10(a+b) + ab.",
                "Start from 100, add ten times the sum of the units, and add the product of the units.",
                "If the units product exceeds 9, carry into the tens: 13×14 = 100 + 70 + 12 = 182.",
            ],
            example: (
                multiplicand: 12,
                multiplier: 14,
                expected: 168,
                caption: "12 × 14 = 100 + 60 + 8 = 168",
                conclusion: "The shortcut only works when both factors are between 11 and 19; otherwise use 空盘前乘法.",
            ),
            show_steps: false,
        ),
        (
            id: "S2",
            title: "Shortcut: same tens, units summing to ten",
            goal: "Multiply numbers with the same tens digit and units that add up to 10.",
            paragraphs: [
                "Condition: same tens digit a and units b, c with b+c = 10.",
                "Formula: a(a+1)·100 + b·c. Write the tens digit times the next one, then append the two digits of the units product.",
                "Example: 43×47 → 4×5 = 20 and 3×7 = 21 → 2021.",
            ],
            example: (
                multiplicand: 43,
                multiplier: 47,
                expected: 2021,
                caption: "4 × 5 = 20 and 3 × 7 = 21 → 2021",
                conclusion: "If the units do not add up to 10, the shortcut does not apply.",
            ),
            show_steps: false,
        ),
        (
            id: "S3",
            title: "Shortcut: same units, tens summing to ten",
            goal: "Multiply numbers with the same units digit and tens that add up to 10.",
            paragraphs: [
                "Condition: same units digit c and tens a, b with a+b = 10.",
                "Formula: (a·b + c)·100 + c². The tens product plus the unit gives the hundreds; the square of the unit gives the last two digits.",
                "Example: 34×74 → 3×7 + 4 = 25 and 4² = 16 → 2516.",
            ],
            example: (
                multiplicand: 34,
                multiplier: 74,
                expected: 2516,
                caption: "3 × 7 + 4 = 25 and 4² = 16 → 2516",
                conclusion: "With different units the shortcut does not apply.",
            ),
            show_steps: false,
        ),
        (
            id: "S4",
            title: "Shortcut: complement multiplication",
            goal: "Multiply a factor close to 100 using its complement.",
            paragraphs: [
                "Condition: one factor is close to 100 (or 1000) and its complement is small.",
                "Formula: A×(100−d) = A·100 − A·d. Shift A two places and subtract A times the complement.",
                "Example: 738×96 = 73 800 − 738×4 = 73 800 − 2 952 = 70 848.",
            ],
            example: (
                multiplicand: 738,
                multiplier: 96,
                expected: 70848,
                caption: "738 × 96 = 73 800 − 2 952 = 70 848",
                conclusion: "The shortcut is a subtraction; if the complement is large, the general method is better.",
            ),
            show_steps: false,
        ),
    ],
)
